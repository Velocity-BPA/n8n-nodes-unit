{
  "name": "n8n-nodes-unit",
  "version": "1.0.0",
  "description": "A comprehensive n8n community node for Unit embedded banking platform providing 26 resources and 200+ operations for banking-as-a-service automation. Includes customer onboarding, account management, ACH/Wire/Check payments, card issuing, and webhook triggers.",
  "license": "SEE LICENSE IN LICENSE.md",
  "author": {
    "name": "Velocity BPA",
    "email": "licensing@velobpa.com",
    "url": "https://velobpa.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Velocity-BPA/n8n-nodes-unit.git"
  },
  "homepage": "https://github.com/Velocity-BPA/n8n-nodes-unit#readme",
  "bugs": {
    "url": "https://github.com/Velocity-BPA/n8n-nodes-unit/issues"
  },
  "keywords": [
    "n8n",
    "n8n-community-node-package",
    "unit",
    "unit-finance",
    "banking",
    "banking-as-a-service",
    "baas",
    "embedded-banking",
    "fintech",
    "ach",
    "wire-transfer",
    "card-issuing",
    "payments",
    "accounts",
    "debit-cards",
    "credit-accounts",
    "check-deposits",
    "counterparty",
    "webhooks",
    "automation"
  ],
  "main": "dist/nodes/Unit/Unit.node.js",
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/UnitApi.credentials.js",
      "dist/credentials/UnitCustomerToken.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Unit/Unit.node.js",
      "dist/nodes/Unit/UnitTrigger.node.js"
    ]
  },
  "scripts": {
    "build": "tsc && gulp build:icons",
    "dev": "tsc --watch",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "prepublishOnly": "npm run build",
    "clean": "rimraf dist"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.1",
    "gulp": "^4.0.2",
    "jest": "^29.7.0",
    "n8n-workflow": "1.57.0",
    "prettier": "^3.2.4",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.2",
    "typescript": "^5.3.3"
  },
  "peerDependencies": {
    "n8n-workflow": ">=1.0.0"
  },
  "dependencies": {
    "axios": "^1.6.7",
    "crypto-js": "^4.2.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}